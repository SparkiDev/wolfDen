# Doxygen configuration for wolfMKA.
# Generate HTML API documentation with:  make docs   (or: doxygen Doxyfile)

PROJECT_NAME           = wolfMKA
PROJECT_BRIEF          = "MACsec Key Agreement (IEEE Std 802.1X) over wolfSSL"
OUTPUT_DIRECTORY       = doc
CREATE_SUBDIRS         = NO

# --- Inputs ---------------------------------------------------------------
# The companion .md documents are listed so the cross-references in README.md
# (COMPLIANCE.md, FMEA.md, ...) resolve into the generated manual.
INPUT                  = include src README.md COMPLIANCE.md FMEA.md \
                         SECURITY.md REQUIREMENTS.md MISRA.md \
                         CHANGELOG.md FOOTPRINT.md \
                         AUTOSAR.md OPEN-ALLIANCE.md MCDC-AND-COVERAGE.md
FILE_PATTERNS          = *.c *.h *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md

# --- C-oriented extraction ------------------------------------------------
OPTIMIZE_OUTPUT_FOR_C  = YES
# EXTRACT_ALL is NO deliberately: with it YES, an undocumented member is still
# rendered (with an empty description) and WARN_IF_UNDOCUMENTED never fires, so
# the docs gate cannot tell a documented API from an undocumented one. With it
# NO, every public type, field and enumerator in include/wolfmka must carry a
# Doxygen comment or `make docs` fails - which is the point of the gate.
# EXTRACT_STATIC is NO for the same reason in reverse: the file-static helpers
# and state in src/*.c are implementation notes, documented in prose next to the
# code rather than in the published manual, and holding them to the public-API
# bar would only add noise.
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
SORT_MEMBER_DOCS       = NO

# Expand the project's function-like and configuration macros so documented
# definitions are not hidden behind the preprocessor.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
# Feature macros are pinned so the documented API matches the default build.
# WOLFMKA_ICV_L2_ADDR is defined rather than zeroed - it is an #ifdef gate - so
# the L2 ICV entry points are documented and covered by the docs gate.
# STD_ON and STD_OFF are both given the value 1 so that the header's own
# "MKA_DEV_ERROR_DETECT == STD_ON" test resolves true and the manual shows what
# MKA_DET_REPORT_ERROR expands to in a build that has Det; the default STD_OFF
# branch is a no-op, and documenting that would describe the reporting as doing
# nothing. Defining MKA_DEV_ERROR_DETECT here instead would skip the header's
# own #ifndef and leave its @def block attached to nothing.
PREDEFINED             = WOLFMKA_NO_EAP=0 \
                         WOLFMKA_NO_XPN=0 \
                         WOLFMKA_NO_DELAY_PROTECT=0 \
                         WOLFMKA_ICV_L2_ADDR \
                         STD_ON=1 \
                         STD_OFF=1

# --- Output ---------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# --- Diagnostics ----------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
