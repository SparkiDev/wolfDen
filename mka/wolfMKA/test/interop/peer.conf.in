# wpa_supplicant MKA / MACsec peer configuration - template for the wolfMKA
# interop harness (test/interop/). The harness substitutes @CTRL@, @CAK@,
# @CKN@, @PRIORITY@ and @CSINDEX@ (0 = GCM-AES-128, 1 = GCM-AES-256) before
# launching wpa_supplicant with the macsec_linux
# driver. PSK-CAK mode (key_mgmt=NONE): the CAK/CKN are pre-shared, exactly as
# the wolfMKA peer is configured, so no EAP exchange is involved.
ctrl_interface=@CTRL@
eapol_version=3
ap_scan=0
fast_reauth=1

network={
	key_mgmt=NONE
	eapol_flags=0
	macsec_policy=1
	macsec_integ_only=0
	mka_cak=@CAK@
	mka_ckn=@CKN@
	mka_priority=@PRIORITY@
	macsec_csindex=@CSINDEX@
}
